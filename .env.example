# Copy this file to `.env` and adjust the values for your machine.
# The real .env file is git-ignored so secrets/local settings never get committed.

# Port the HTTP server listens on
PORT=3000

# Path to the SQLite database file (created automatically if it doesn't exist).
# Use :memory: for a throwaway in-memory database.
DB_PATH=./library.db

# "development" shows full error messages; "production" hides internal details
NODE_ENV=development
